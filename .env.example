# Supabase Configuration (required)
# Get these from your Supabase project dashboard: Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Site URL (update for production)
VITE_SITE_URL=http://localhost:3000

# === Server-side secrets (Netlify Environment Variables ONLY) ===
# NEVER put these in frontend code or commit them to git

# Supabase service role key (for Netlify Functions)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend API key (for contact form email notifications)
# RESEND_API_KEY=your-resend-api-key

# Contact notification email
# CONTACT_EMAIL=subhasishdebadhikari@gmail.com
